  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node scripts/clean.mjs",
    "dev": "tsx src/index.ts",
    "test": "node --test \"tests/*.test.mjs\"",
    "smoke": "node scripts/smoke.mjs",
    "e2e:ui": "node tests/e2e/cad-ui.e2e.mjs",
