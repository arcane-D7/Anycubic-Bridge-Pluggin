    "pngjs": "^7.0.0",
    "replicad": "^1.1.0",
    "replicad-opencascadejs": "^1.1.0",
    "three": "0.186.0",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.15",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "@types/pngjs": "^6.0.5",
    "esbuild": "0.28.2",
    "puppeteer-core": "^25.10.0",
    "tsx": "4.20.6",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.19.0"
