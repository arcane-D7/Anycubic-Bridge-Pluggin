root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Align with Prettier defaults (no .prettierrc in repo)
[*.{js,mjs,cjs,ts,tsx,json,jsonc,yaml,yml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Binary / generated
[*.{stl,3mf,gcode,png,jpg,jpeg,webp,ico,zip,gz}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
